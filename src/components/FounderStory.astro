---
import Picture from './ui/Picture.astro';
import { getCopy, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<section class="founder section" aria-labelledby="founder-title">
  <div class="founder__inner container container--wide">
    <div class="founder__media" data-reveal>
      <Picture
        slotLabel={copy.founder.imageSlot}
        alt={copy.founder.imageAlt}
        ratio="4 / 5"
        sizes="(max-width: 62rem) 92vw, 42vw"
        widths={[420, 640, 900, 1200]}
      />

      <!-- The quote overlaps the portrait: attributed, and marked in the
           config as still awaiting Elisabeth's sign-off. -->
      <figure class="founder__quote">
        <blockquote>
          <p>{copy.founder.quote}</p>
        </blockquote>
        <figcaption>{copy.founder.quoteAttribution}</figcaption>
      </figure>
    </div>

    <div class="founder__content" data-reveal style="--reveal-delay: 90ms">
      <p class="eyebrow">{copy.founder.eyebrow}</p>
      <h2 class="founder__title" id="founder-title">{copy.founder.title}</h2>

      <div class="founder__body prose">
        {copy.founder.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="founder__faith">
        <h3 class="founder__faith-title">{copy.founder.faithTitle}</h3>
        <p>{copy.founder.faithBody}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .founder {
    background-color: var(--color-background);
  }

  .founder__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .founder__media {
    position: relative;
  }

  .founder__quote {
    position: relative;
    z-index: 1;
    margin: calc(var(--space-lg) * -1) 0 0 var(--space-md);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-lifted);
  }

  .founder__quote blockquote {
    margin: 0;
  }

  .founder__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-wrap: balance;
  }

  /* An amber rule instead of a quotation glyph: quieter, and it echoes the
     rule under the section eyebrows. */
  .founder__quote figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-muted);
  }

  .founder__quote figcaption::before {
    content: '';
    inline-size: var(--space-lg);
    block-size: 2px;
    background-color: var(--color-accent);
    flex: none;
  }

  .founder__content {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  .founder__title {
    margin: 0;
    font-size: var(--text-2xl);
    max-inline-size: 20ch;
  }

  .founder__body {
    font-size: var(--text-md);
    color: var(--color-muted);
    max-inline-size: var(--measure);
  }

  .founder__faith {
    margin-block-start: var(--space-2xs);
    padding-inline-start: var(--space-md);
    border-inline-start: 2px solid var(--color-accent);
  }

  .founder__faith-title {
    margin: 0 0 var(--space-3xs);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-primary-ink);
  }

  .founder__faith p {
    margin: 0;
    color: var(--color-muted);
    max-inline-size: 52ch;
  }

  /* A full-width 4:5 portrait is taller than the viewport on a tablet, so the
     column is capped before the layout goes side by side. */
  @media (max-width: 61.999rem) {
    .founder__media {
      max-inline-size: 26rem;
    }
  }

  @media (min-width: 62rem) {
    .founder__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap-col);
      align-items: center;
    }

    .founder__media {
      grid-column: 1 / span 5;
    }

    .founder__quote {
      /* Reaches into the column gap so image and words interlock. */
      margin-inline: var(--space-xl) calc(var(--space-xl) * -1);
      margin-block-start: calc(var(--space-xl) * -1);
    }

    .founder__content {
      grid-column: 7 / span 6;
      gap: var(--space-lg);
    }
  }
</style>
