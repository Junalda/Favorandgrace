---
/**
 * The single button primitive. Renders an anchor when `href` is given and a
 * real <button> otherwise, so semantics always match behaviour.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse' | 'inverse-outline';
  size?: 'md' | 'lg';
  fullWidth?: boolean;
  disabled?: boolean;
  class?: string;
  'aria-label'?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  fullWidth ? 'btn--full' : null,
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';
// A disabled anchor is not a thing in HTML, so a "disabled" link is
// announced as such and taken out of the tab order instead.
const tagProps = href
  ? { href, ...(disabled ? { 'aria-disabled': 'true' as const, tabindex: -1 } : {}) }
  : { type, disabled };
---

<Tag class={classes} {...tagProps} {...rest}>
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    --btn-bg: var(--color-primary);
    --btn-ink: var(--color-on-dark);
    --btn-border: var(--color-primary);
    --btn-bg-hover: var(--color-primary-deep);
    --btn-border-hover: var(--color-primary-deep);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    /* Comfortably above the 44px touch target minimum at every size. */
    min-block-size: 3rem;
    padding: 0.75rem var(--space-md);
    border: 1.5px solid var(--btn-border);
    border-radius: var(--radius-pill);
    background-color: var(--btn-bg);
    color: var(--btn-ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .btn--lg {
    min-block-size: 3.5rem;
    padding: 0.9rem var(--space-lg);
    font-size: var(--text-base);
  }

  .btn--full {
    inline-size: 100%;
  }

  .btn__label {
    display: block;
    /* Keeps the optical centre correct with the pill radius. */
    transform: translateY(-0.02em);
  }

  .btn:hover {
    background-color: var(--btn-bg-hover);
    border-color: var(--btn-border-hover);
    color: var(--btn-ink);
    box-shadow: var(--shadow-soft);
  }

  .btn:active {
    transform: translateY(1px);
    box-shadow: none;
  }

  /* --- Variants ---------------------------------------------------------- */

  .btn--secondary {
    --btn-bg: transparent;
    --btn-ink: var(--color-text);
    --btn-border: var(--color-border-strong);
    --btn-bg-hover: var(--color-surface);
    --btn-border-hover: var(--color-text);
  }

  .btn--secondary:hover {
    color: var(--color-text);
  }

  .btn--ghost {
    --btn-bg: transparent;
    --btn-ink: var(--color-primary-ink);
    --btn-border: transparent;
    --btn-bg-hover: transparent;
    --btn-border-hover: transparent;
    padding-inline: var(--space-2xs);
    min-block-size: 2.75rem;
  }

  .btn--ghost .btn__label {
    box-shadow: inset 0 -1.5px 0 color-mix(in srgb, currentColor 45%, transparent);
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  .btn--ghost:hover {
    box-shadow: none;
    color: var(--color-primary-ink);
  }

  .btn--ghost:hover .btn__label {
    box-shadow: inset 0 -1.5px 0 currentColor;
  }

  .btn--inverse {
    --btn-bg: var(--color-on-dark);
    /* Not --color-text: dark grounds remap that to cream, which would make
       the label invisible on this button. */
    --btn-ink: var(--color-ink-deep);
    --btn-border: var(--color-on-dark);
    --btn-bg-hover: #ffffff;
    --btn-border-hover: #ffffff;
  }

  .btn--inverse:hover {
    color: var(--color-ink-deep);
  }

  .btn--inverse-outline {
    --btn-bg: transparent;
    --btn-ink: var(--color-on-dark);
    --btn-border: rgba(251, 246, 238, 0.5);
    --btn-bg-hover: rgba(251, 246, 238, 0.12);
    --btn-border-hover: var(--color-on-dark);
  }

  .btn--inverse-outline:hover {
    color: var(--color-on-dark);
  }

  .btn[aria-disabled='true'],
  .btn:disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
