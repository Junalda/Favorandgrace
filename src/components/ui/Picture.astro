---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { flags } from '../../data/site';

/**
 * Image slot.
 *
 * Renders an optimised, responsive image when real photography is configured.
 * When it is not, it renders a branded, clearly-labelled slot instead of a
 * stock photo — the site never shows people who are not part of Favour & Grace.
 *
 * The slot reserves its aspect ratio in both states, so dropping a photo in
 * later cannot shift the layout.
 */
interface Props {
  /** Imported image, e.g. `import photo from '../assets/photo.jpg'`. */
  src?: ImageMetadata;
  /** Describes the photograph for screen readers. Required when `src` is set. */
  alt?: string;
  /** Short description of the photo this slot is waiting for. */
  slotLabel: string;
  /** CSS aspect-ratio value, e.g. '4 / 5'. */
  ratio?: string;
  /** Responsive `sizes` attribute. */
  sizes?: string;
  /** Candidate widths for the srcset. */
  widths?: number[];
  /** Above the fold: loads eagerly with high priority. */
  priority?: boolean;
  tone?: 'sand' | 'teal' | 'terracotta';
  class?: string;
}

const {
  src,
  alt = '',
  slotLabel,
  ratio = '4 / 5',
  sizes = '(max-width: 48rem) 100vw, 50vw',
  widths = [480, 768, 1024, 1440, 1920],
  priority = false,
  tone = 'sand',
  class: className,
} = Astro.props;

const availableWidths = src ? widths.filter((w) => w <= src.width) : widths;
const srcsetWidths = availableWidths.length > 0 ? availableWidths : widths.slice(0, 1);
---

<figure
  class:list={['pic', `pic--${tone}`, className]}
  style={`--pic-ratio: ${ratio};`}
>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        widths={srcsetWidths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="pic__img"
      />
    ) : (
      <div class="pic__slot">
        <svg
          class="pic__motif"
          viewBox="0 0 200 200"
          aria-hidden="true"
          focusable="false"
        >
          <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M40 150a60 60 0 0 1 120 0" />
            <path d="M22 150a78 78 0 0 1 156 0" opacity="0.55" />
            <path d="M58 150a42 42 0 0 1 84 0" opacity="0.75" />
            <path d="M100 44v-20" />
            <path d="M143 62l14-14" />
            <path d="M57 62 43 48" />
            <path d="M164 105h20" />
            <path d="M16 105h20" />
            <path d="M170 74l18-8" />
            <path d="M30 74l-18-8" />
          </g>
        </svg>
        {flags.showPhotoPlaceholderLabels && (
          <p class="pic__label">
            <span class="pic__dot" aria-hidden="true" />
            {slotLabel}
          </p>
        )}
      </div>
    )
  }
  <slot name="caption" />
</figure>

<style>
  .pic {
    position: relative;
    margin: 0;
    aspect-ratio: var(--pic-ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-sand);
    isolation: isolate;
  }

  .pic__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* A very slight warm lift so candid phone photography sits comfortably
       next to the rest of the page. */
    filter: saturate(1.02) contrast(1.01);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .pic__slot {
    position: relative;
    display: flex;
    align-items: flex-start;
    block-size: 100%;
    padding: var(--space-md);
    background-image: linear-gradient(
      150deg,
      var(--slot-from, #f6ecdc) 0%,
      var(--slot-to, #eaddc7) 100%
    );
    color: var(--slot-motif, var(--color-accent));
  }

  .pic--teal .pic__slot {
    --slot-from: #1a656b;
    --slot-to: #0f4348;
    --slot-motif: var(--color-accent-soft);
  }

  .pic--terracotta .pic__slot {
    --slot-from: #b4432a;
    --slot-to: #8c2f18;
    --slot-motif: var(--color-accent-soft);
  }

  .pic__motif {
    position: absolute;
    inset-block-end: -14%;
    inset-inline-start: 50%;
    inline-size: min(64%, 18rem);
    translate: -50% 0;
    opacity: 0.34;
  }

  .pic--teal .pic__motif,
  .pic--terracotta .pic__motif {
    opacity: 0.26;
  }

  .pic__label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    max-inline-size: 100%;
    margin: 0;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background-color: rgba(255, 255, 255, 0.92);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
    line-height: 1.3;
    backdrop-filter: blur(6px);
  }

  .pic--teal .pic__label,
  .pic--terracotta .pic__label {
    background-color: rgba(20, 14, 10, 0.72);
    color: var(--color-on-dark);
  }

  .pic__dot {
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background-color: var(--color-primary);
    flex: none;
  }

  .pic--teal .pic__dot,
  .pic--terracotta .pic__dot {
    background-color: var(--color-accent);
  }
</style>
